# ==========================================
# CONFIGURAÇÃO GERAL DA APLICAÇÃO
# ==========================================
NODE_ENV=production
APP_NAME=Agilizap

# Portas expostas no host
BACKEND_PORT=8080
FRONTEND_PORT=3000

# URLs públicas (acessíveis pelo navegador / atendentes)
# Em ambiente local, use localhost. Em produção VPS, use seu domínio/subdomínio com HTTPS
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
PROXY_PORT=

# Configurações do Frontend
REACT_APP_NAME_SYSTEM=Agilizap
REACT_APP_HOURS_CLOSE_TICKETS_AUTO=24

# ==========================================
# BANCO DE DADOS (PostgreSQL)
# ==========================================
DB_DIALECT=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=agilizap
DB_PASS=agilizap_db_pass_alterar
DB_NAME=agilizap

# ==========================================
# CACHE & FILAS (Redis)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=agilizap_redis_pass_alterar
REDIS_URI=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000

# ==========================================
# AUTENTICAÇÃO E SEGURANÇA (JWT)
# Gere novas chaves seguras em produção: openssl rand -base64 32
# ==========================================
JWT_SECRET=kZaOTd+YZpjRUyyuQUpigJaEMk4vcW4YOymKPZX0Ts8=
JWT_REFRESH_SECRET=dBSXqFg9TaNUEDXVp6fhMTRLBysP+j2DSqf7+raxD3A=

# ==========================================
# LIMITES OPERACIONAIS (Uso Interno: até 10 atendentes)
# ==========================================
USER_LIMIT=10
CONNECTIONS_LIMIT=10
CLOSED_SEND_BY_ME=true

# ==========================================
# INTELIGÊNCIA ARTIFICIAL (Preparado para Fase 4)
# Provedor padrão: Google Gemini 1.5 Flash (custo-benefício e cota gratuita)
# Alternativa: OpenAI (GPT-4o-mini)
# ==========================================
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# E-MAIL / NOTIFICAÇÕES (Opcional)
# ==========================================
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# ==========================================
# INTEGRAÇÕES FINANCEIRAS (Opcional - Gerencianet / Efí)
# ==========================================
GERENCIANET_SANDBOX=false
GERENCIANET_CLIENT_ID=
GERENCIANET_CLIENT_SECRET=
GERENCIANET_PIX_CERT=
GERENCIANET_PIX_KEY=
